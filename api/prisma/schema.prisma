// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionCategory {
  FOOD
  SHOPPING
  RENT
  TRANSPORT
  SALARY
  ENTERTAINMENT
  BAR
  EATOUT
  OTHER
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  CARD
  CASH
  SAVINGS
  OTHER
}

model User {
  id                    Int              @id @default(autoincrement())
  googleId              String?          @unique
  email                 String           @unique
  passwordHash          String?
  isVerified            Boolean          @default(false)
  verificationCode      String?
  verificationExpiresAt DateTime?
  name                  String?
  avatarUrl             String?
  currency              String           @default("EUR")
  role                  Role             @default(USER)
  accounts              Account[]
  transactions          Transaction[]
  sessions              Session[]
  monthlySummaries      MonthlySummary[]
  budgets               Budget[]
}

model Account {
  id           Int           @id @default(autoincrement())
  userId       Int
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         AccountType   @default(OTHER)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model Transaction {
  id          Int      @id @default(autoincrement())
  title       String
  amount      Float
  type        String
  category    TransactionCategory
  date        DateTime
  description String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notes       Note[]
}

model Note {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model MonthlySummary {
  id                Int                      @id @default(autoincrement())
  userId            Int
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year              Int
  month             Int
  incomeTotal       Float
  spentTotal        Float
  leftTotal         Float
  aiInsights        String?
  aiGeneratedAt     DateTime?
  aiDataHash        String?
  categorySummaries MonthlyCategorySummary[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([userId, year, month])
}

model MonthlyCategorySummary {
  id               Int                 @id @default(autoincrement())
  monthlySummaryId Int
  monthlySummary   MonthlySummary      @relation(fields: [monthlySummaryId], references: [id], onDelete: Cascade)
  category         TransactionCategory
  amount           Float

  @@unique([monthlySummaryId, category])
}

model Budget {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  limitAmount Float
  categories  String
  createdAt   DateTime @default(now())
}
